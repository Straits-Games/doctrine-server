# doctrine-server settings. Copy to `.env` (same folder you start the server from,
# or pass --env-file) and fill in. Real environment variables override this file.
# Never commit your real .env: it holds secrets.

# External base URL players reach the server at (no trailing slash). Used for the
# sign-in link and the Discord OAuth redirect. Leave empty on a LAN to use whatever
# address each client connected to.
DOCTRINE_PUBLIC_URL=https://doctrine.example.org

# Bind address and port.
DOCTRINE_HOST=0.0.0.0
DOCTRINE_PORT=8080

# Where the SQLite database, turn files and custom scenarios are stored.
DOCTRINE_DATA_DIR=./data

# Shown on the sign-in pages and in /server-info.
DOCTRINE_SERVER_NAME=Doctrine server
DOCTRINE_MOTD=

# Research mode: tell players this server keeps game records for AI research, and
# allow `doctrine-server export-games` and the telemetry listener. Off by default.
# The listener serves every game's record (passphrases included): bind it to your
# LAN address, never through the public proxy. See docs/OPERATING.md.
DOCTRINE_RESEARCH=off
# DOCTRINE_RESEARCH_NOTICE=
# DOCTRINE_RESEARCH_HOST=192.168.1.10
# DOCTRINE_RESEARCH_PORT=8081
# DOCTRINE_RESEARCH_TOKEN=

# Local accounts (display name + password). Set a join code to enable them; new
# players need it to create an account (not to sign in again). Pick something long.
DOCTRINE_JOIN_CODE=

# Upload caps in MB (larger uploads get HTTP 413).
DOCTRINE_MAX_TURN_MB=8
DOCTRINE_MAX_SCENARIO_MB=32

# Reverse proxies allowed to set X-Forwarded-For (comma-separated IPs, or * to trust
# any). Needed for per-IP rate limits behind Caddy/nginx/a tunnel.
DOCTRINE_FORWARDED_ALLOW_IPS=127.0.0.1

# ---- optional Discord plugin (see docs/DISCORD.md) ----
# "Sign in with Discord" (OAuth2, identify scope).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# The bot: turn notifications, lobby announcements, slash commands, guild gate.
# Needs `pip install "doctrine-server[discord]"` (the Docker image includes it).
DISCORD_BOT_TOKEN=
# Your Discord server (guild). With the bot set, Discord sign-in requires membership.
DISCORD_GUILD_ID=
# Lobby channel for challenges and results.
DISCORD_CHANNEL_ID=
# If set, one text channel per game is created under this category; ended games
# move to a category named "Archive".
DISCORD_GAMES_CATEGORY=
# Optional invite link shown in /server-info and to non-members.
DISCORD_INVITE_URL=
